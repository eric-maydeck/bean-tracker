{
  "name": "bean-tracker",
  "version": "1.100.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "nice -n 10 vitest run",
    "test:ui": "playwright test",
    "test:ui:performance": "UI_PROFILE=performance playwright test",
    "test:ui:background": "UI_PROFILE=background playwright test",
    "test:ui:prod": "UI_BUILD=prod playwright test",
    "test:ui:prod:performance": "UI_BUILD=prod UI_PROFILE=performance playwright test",
    "test:ui:prod:background": "UI_BUILD=prod UI_PROFILE=background playwright test",
    "test:changed": "node scripts/test-changed.ts",
    "test:changed:performance": "UI_PROFILE=performance node scripts/test-changed.ts",
    "test:changed:background": "UI_PROFILE=background node scripts/test-changed.ts",
    "shots:diff": "node scripts/shots-diff.ts",
    "migrate": "node scripts/migrate.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.7",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "exceljs": "^4.4.0",
    "jszip": "3.10.2",
    "protobufjs": "^8.8.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  }
}
